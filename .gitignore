# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Electron build output
/dist
/release
/out

# Generated by postbuild — copy of package.json under a non-conflicting
# name so electron-builder's extraResources can drop it at
# Contents/Resources/app/package.json without colliding with the asar's
# own root package.json (see electron-builder#4160).
/next-runtime-package.json

# Local SQLite data
*.db
*.db-journal
*.db-wal
*.db-shm

# Editor
.vscode/
.idea/

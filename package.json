{
  "name": "ssh-session-manager",
  "version": "0.2.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "lint": "eslint",
    "electron": "electron .",
    "electron:dev": "NEXT_DISABLE_TURBOPACK=1 next build && electron .",
    "electron:build": "next build && electron-builder",
    "electron:mac": "next build && electron-builder --mac",
    "electron:win": "next build && electron-builder --win"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.davytan.sshmanager",
    "productName": "SSH Manager",
    "directories": {
      "buildResources": "electron/build",
      "output": "dist"
    },
    "asar": false,
    "extraResources": [
      {
        "from": ".next",
        "to": "app/.next",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "app/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules",
        "to": "app/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "package.json",
        "to": "app/package.json"
      },
      {
        "from": "next.config.ts",
        "to": "app/next.config.ts"
      }
    ],
    "files": [
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "win": {
      "target": "nsis",
      "icon": "electron/build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "davyprotan",
        "repo": "ssh-session-manager",
        "releaseType": "release"
      }
    ]
  }
}

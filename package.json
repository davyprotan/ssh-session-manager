{
  "name": "ssh-session-manager",
  "version": "0.9.44",
  "private": true,
  "main": "electron/main.js",
  "description": "Local SSH session and credential manager — Next.js + Electron, dark cyan UI",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Davy Tan",
  "homepage": "https://github.com/davyprotan/ssh-session-manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/davyprotan/ssh-session-manager.git"
  },
  "bugs": {
    "url": "https://github.com/davyprotan/ssh-session-manager/issues"
  },
  "scripts": {
    "dev": "next dev -p 3005 -H 127.0.0.1",
    "build": "next build --webpack",
    "postbuild": "node scripts/prepare-runtime.mjs",
    "start": "next start -p 3005 -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "electron .",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:mac": "npm run build && electron-builder --mac",
    "electron:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@types/better-sqlite3": "^7.6.13",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "keytar": "^7.9.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.davytan.sshmanager",
    "productName": "SSH Manager",
    "directories": {
      "buildResources": "electron/build",
      "output": "dist"
    },
    "afterPack": "electron/build/afterPack.js",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/keytar/**",
      "**/node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": ".next",
        "to": "app/.next",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "app/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".build-runtime/node_modules",
        "to": "app/node_modules",
        "filter": [
          "**/*",
          "!**/*.d.ts",
          "!**/*.map",
          "!**/*.md",
          "!**/CHANGELOG*",
          "!**/HISTORY*",
          "!**/AUTHORS*",
          "!**/CONTRIBUTING*",
          "!**/LICENSE.txt",
          "!**/.github/**",
          "!**/.bin/**",
          "!**/test/**",
          "!**/tests/**",
          "!**/__tests__/**",
          "!**/example/**",
          "!**/examples/**"
        ]
      },
      {
        "from": "next-runtime-package.json",
        "to": "app/package.json"
      },
      {
        "from": "next.config.ts",
        "to": "app/next.config.ts"
      }
    ],
    "files": [
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": "-",
      "entitlements": "electron/build/entitlements.mac.plist",
      "entitlementsInherit": "electron/build/entitlements.mac.plist"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "davyprotan",
        "repo": "ssh-session-manager",
        "releaseType": "release"
      }
    ]
  }
}
